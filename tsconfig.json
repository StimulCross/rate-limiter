{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "Node16",

		"lib": ["ES2022", "ES2024.Promise"],

		"outDir": "lib",

		"strict": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"importHelpers": true,

		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,

		"declaration": true,
		"declarationMap": true,

		"rootDir": "src",
		"skipLibCheck": true
	},
	"include": ["src"]
}
