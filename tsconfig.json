{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM",
			"ESNext.Decorators",
			"ES2024.Promise"
		],
		"module": "node20",
		"moduleResolution": "node16",
		"types": ["node"],
		"strict": true,
		"strictNullChecks": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"declaration": true,
		"declarationMap": true,
		"noEmit": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts",
		"eslint.config.ts"
	],
	"exclude": ["lib", "node_modules"]
}
